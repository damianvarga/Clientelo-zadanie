# Povinné: žiadne. Bez všetkých premenných stránka funguje
# a leady sa zapisujú do function logov (mode: "log_only").

# Voliteľné – Resend API kľúč (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxx

# Voliteľné – odosielateľ (bez vlastnej domény nechajte default)
RESEND_FROM=ETF Clientelo <onboarding@resend.dev>

# Voliteľné – kam chodia odpovede
REPLY_TO=vuj@email.cz

# Voliteľné – Upstash Redis (https://console.upstash.com → Create database)
# Bez nich sa leady neukladajú do databázy (vracia sa "stored": false).
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxx
