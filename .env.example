# Povinné pre plný konverzný flow: UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN
# (bez nich endpoint vracia 503 db_not_configured a formulár pre používateľa zlyhá).
# RESEND_API_KEY je voliteľný: bez neho sa lead uloží do Redis a vracia sa
# mode: "log_only" (e-mail s reportom sa nepošle).

# Voliteľné – Resend API kľúč (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxx

# Voliteľné – odosielateľ (bez vlastnej domény nechajte default)
RESEND_FROM=ETF Clientelo <onboarding@resend.dev>

# Voliteľné – kam chodia odpovede
REPLY_TO=vuj@email.cz

# Voliteľné – tajomstvo pre podpis unsubscribe odkazov v e-mailech
# (ak chýba, použije sa RESEND_API_KEY)
UNSUBSCRIBE_SECRET=change-me-long-random-string

# Potrebné – Upstash Redis (https://console.upstash.com → Create database)
# Bez nich sa lead neuloží; endpoint vracia HTTP 503 { "error": "db_not_configured" }.
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxx
